      "name": "newContact",
      "description": "The new contact object bound to the form fields.",
      "type": "property",
      "value": "{ name: '', phone: '', email: '', address: '' }"
    },
    {
      "name": "saveContact",
      "description": "Saves the new contact to localStorage and navigates to its details page.",
      "type": "method",
      "body": "const contacts = JSON.parse(localStorage.getItem('contacts') || '[]');\n$ctrl.newContact.id = String(Date.now());\ncontacts.push($ctrl.newContact);\nlocalStorage.setItem('contacts', JSON.stringify(contacts));\n$ctrl.$state.go('contacts.contact-details', { id: $ctrl.newContact.id }, { reload: true });",
